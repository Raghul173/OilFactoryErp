# Backend Environment Variables
PORT=5000
NODE_ENV=development

# MySQL Database URL format:
# Local: mysql://<user>:<password>@localhost:3306/<database_name>
# TiDB Cloud (Free): mysql://<user>.<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<database_name>?sslaccept=strict
# Aiven MySQL (Free): mysql://avnadmin:<password>@<host>:<port>/defaultdb?ssl-mode=REQUIRED
DATABASE_URL="mysql://root:password@localhost:3306/oilfactory_db"

# Authentication Secrets
JWT_SECRET="smartoil_enterprise_super_secret_jwt_key_2026_x89a_production_grade"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 Client ID (for verifying Google sign-in tokens)
GOOGLE_CLIENT_ID="831782947192-examplegoogleclientid.apps.googleusercontent.com"

# Admin Bootstrap Email (Automatically given Administrator role upon first login)
ADMIN_EMAIL="raghuluma2006@gmail.com"

# Allowed Frontend Origins for CORS & Socket.io (comma-separated if multiple)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
