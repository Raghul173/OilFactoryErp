{
  "name": "oilfactory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"FRONTEND,BACKEND\" -c \"cyan,green\" \"npm run dev:client\" \"npm run server\"",
    "dev:client": "npm run dev --prefix frontend",
    "server": "npm start --prefix backend",
    "start": "npm run dev",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
